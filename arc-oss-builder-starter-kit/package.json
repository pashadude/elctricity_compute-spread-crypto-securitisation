    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "arc",
    "arc-testnet",
    "erc-8004",
    "erc-8183",
    "circle",
    "usdc",
    "starter-kit"
  ]
