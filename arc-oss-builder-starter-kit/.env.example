# Arc RPC. Default to the public endpoint. `arc-canteen rpc-url --export` can
# provide an optional authenticated URL when the Canteen proxy is healthy.
ARC_RPC=https://rpc.testnet.arc.network

# Circle Developer-Controlled Wallets.
# Never commit real values.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=

# Optional override for the repository URL printed by `npm run submission-link`.
ARC_OSS_REPO_URL=https://github.com/pashadude/elctricity_compute-spread-crypto-securitisation/tree/main/arc-oss-builder-starter-kit

# Starter-kit wallet set name. Change per project if you reuse the kit.
CIRCLE_WALLET_SET_NAME=arc-oss-builder-starter-kit
