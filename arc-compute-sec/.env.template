# Circle Developer-Controlled Wallets (TESTNET scope)
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=

# Arc Testnet RPC
# Default: the public Arc Testnet endpoint.
# Recommended for hackathon visibility: run `arc-canteen login` then
# `arc-canteen rpc-url --export` and paste the proxied URL here. That
# routes our chain reads through the organisers' rate-limited proxy
# and lets them attribute traffic to our team.
# Both ARC_RPC (read by Python on_chain.py + web3.py log decode) and
# RPC (read by TS scripts as process.env.RPC) must point at the SAME
# endpoint to keep tx-hash / receipt views consistent.
ARC_RPC=https://rpc.testnet.arc.network
RPC=https://rpc.testnet.arc.network

# Upstream relayer (read-only consumption)
# Required for Polymarket direct-event slugs because we preserve the upstream
# premium scorer. In Docker this host path is mounted read-only into
# /app/upstream/py-builder-relayer-client.
UPSTREAM_RELAYER_PATH=/Users/pauldudko/VSProjects/py-builder-relayer-client

# EIA API v2 — register at https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# IBKR Paper Gateway / TWS
IBKR_HOST=127.0.0.1
IBKR_GATEWAY_PORT=4002
IBKR_CLIENT_ID=42
# Docker services use separate client ids so API, worker, telegram, and local
# smoke commands do not collide with each other or other IBKR API clients.
IBKR_API_CLIENT_ID=42
IBKR_WORKER_CLIENT_ID=43
IBKR_TELEGRAM_CLIENT_ID=44

# IBKR ForecastTrader / ForecastEx event contracts.
# This is the direct IBKR prediction-market surface (`ibkr_prediction`).
# TWS discovery can list account-visible event underliers. Priced YES/NO
# contract discovery additionally needs authenticated IBKR Client Portal/Web API
# at IBKR_CP_BASE_URL because IBKR resolves event conids via Web API endpoints.
IBKR_FORECAST_DISCOVERY=0
IBKR_FORECAST_MARKET_SOURCE=tws
IBKR_TWS_FORECAST_TERMS=electricity,renewable energy,natural gas,crude oil,Nvidia,industrial production,Fed Funds,CPI,unemployment,GDP
# macOS ControlCenter/AirPlay often owns port 5000. Set Client Portal Gateway
# `listenPort: 5055` in root/conf.yaml and use 5055 locally.
IBKR_CP_BASE_URL=https://localhost:5055/v1/api
IBKR_DOCKER_CP_BASE_URL=https://host.docker.internal:5055/v1/api
IBKR_CP_VERIFY_SSL=0
IBKR_CP_TIMEOUT=8
IBKR_CP_AUTO_REAUTH=1
IBKR_CP_RESTORE_TIMEOUT=3
IBKR_CP_REAUTH_WAIT_SECONDS=8
IBKR_FORECAST_MAX_MARKETS=6
IBKR_FORECAST_MAX_MONTHS=2
IBKR_FORECAST_MAX_STRIKES=4
# Dashboard/TG direct-event inventory. These rows explain the real watchlist
# legs and stay read-only until the normal priced/gated candidate path passes.
DIRECT_EVENT_INVENTORY_ENABLED=1
IBKR_DIRECT_EVENT_SYMBOLS=RETXC,ITNVD,CRUDB,NGP
POLYMARKET_DIRECT_EVENT_SLUGS=ai-data-center-moratorium-passed-before-2027,ai-bubble-burst-by
POLYMARKET_DIRECT_EVENT_FETCH=1
# Kalshi public event-contract watchlist. Uses unauthenticated read-only
# market data from https://external-api.kalshi.com/trade-api/v2/events and
# filters for AI/compute terms before showing rows as `kalshi` direct legs.
KALSHI_DIRECT_EVENT_FETCH=1
KALSHI_DIRECT_EVENT_TERMS=ai,artificial intelligence,openai,anthropic,nvidia,gpu,llm,agi,data center,compute
KALSHI_DIRECT_EVENT_LIMIT=200
KALSHI_DIRECT_EVENT_MAX_PAGES=3
KALSHI_DIRECT_EVENT_MAX_EVENTS=8
SIZING_KALSHI_USDC=1.0
# Public priced hedge basket used by the dynamic mock contract.
# Default is Yahoo. Optional order: ibkr,alpaca,yahoo. IBKR needs TWS/Gateway;
# Alpaca needs ALPACA_API_KEY_ID/ALPACA_SECRET_KEY; Yahoo needs no key.
PUBLIC_HEDGE_FETCH=1
PUBLIC_HEDGE_SYMBOLS=NVDA,VRT,ETN,CEG,NRG,BTC-USD,ETH-USD
PUBLIC_HEDGE_PRICE_SOURCES=yahoo
ALPACA_API_KEY_ID=
ALPACA_SECRET_KEY=
# Optional curated fallback for known account-eligible contracts.
# Example:
# IBKR_PREDICTION_EVENTS_JSON=[{"id":"forecastx-ercot","slug":"ercot-grid-stress-jun-2026","title":"Will ERCOT issue an emergency grid alert by Jun 30, 2026?","description":"Direct grid-stress leg for electricity-expensive compute/energy packages.","yes_prices":[0.55,0.48],"end_date":"2026-06-30T00:00:00Z","venue":"IBKR ForecastTrader","exchange":"FORECASTX","sec_type":"OPT"}]
IBKR_PREDICTION_EVENTS_JSON=

# Runtime tuning
ARB_Z_THRESHOLD=1.0
ARB_K_FACTOR=0.5
ARB_KWH_PER_GPU_HR=0.7

# Backend API / frontend serving
API_HOST=0.0.0.0
API_PORT=8080
PORT=8080
API_ACCESS_LOG=0
API_CORS_ORIGIN=*
FRONTEND_DIR=../frontend
ARC_LOG_DIR=logs

# Server-owned Operator accounts.
# Generate a long random value before public launch, for example:
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
ACCOUNT_SESSION_SECRET=
# Set to 1 behind HTTPS on power.botozen.com. Leave 0 only for localhost HTTP.
ACCOUNT_COOKIE_SECURE=0
# Keep 1 for the hackathon demo button. Set 0 for production so paid access
# can only be activated by verified Circle webhooks.
ALLOW_DEMO_OPERATOR_PAYMENT=1
CIRCLE_WEBHOOK_REQUIRE_SIGNATURE=1
CIRCLE_WEBHOOK_PUBLIC_KEY_URL_TEMPLATE=https://api.circle.com/v2/notifications/publicKey/{keyId}

# Live-chain safety gates. Keep disabled for local/Docker dry-runs unless the
# operator deliberately enables live Arc Testnet submissions.
ENABLE_LIVE_CHAIN=0
WORKER_LIVE_CHAIN=0

# 24/7 worker
WORKER_INTERVAL_SECONDS=300
WORKER_ERROR_BACKOFF_SECONDS=60
WORKER_MAX_POSITIONS=1
WORKER_MULTI_SURFACE=1
WORKER_SETTLE=0
SIZING_POLYMARKET_USDC=1.0
SIZING_IBKR_PREDICTION_USDC=1.0
SIZING_CRYPTO_USDC=1.0
SIZING_EQUITY_USDC=1.0
ARC_JOB_EXPIRES_SECONDS=600
# Optional demo override. Leave empty for feed-derived z-score.
WORKER_FORCE_SIGNAL=

# Optional oracle evidence only. These are not needed for Polymarket slugs,
# IBKR prediction slugs, routing, the judge, or Arc wrapping.
OPOINT_API_KEY=
NEBIUS_API_KEY=

# Telegram Bot API / channel integration. Use polling locally; ngrok is only
# needed for Telegram Mini App/webhook URLs.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_ADMIN_USER_IDS=
TELEGRAM_MODE=polling
TELEGRAM_NOTIFY_MAX_PER_PASS=3
IBKR_REAUTH_REMINDER_ENABLED=1
IBKR_REAUTH_REMINDER_INTERVAL_HOURS=4
# Defaults to the first TELEGRAM_ADMIN_USER_IDS entry if left empty.
IBKR_REAUTH_REMINDER_CHAT_ID=
PUBLIC_BASE_URL=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
