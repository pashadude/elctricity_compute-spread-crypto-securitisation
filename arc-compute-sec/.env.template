# Circle Developer-Controlled Wallets (TESTNET scope)
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=

# Arc Testnet RPC
# Default: the public Arc Testnet endpoint.
# Recommended for hackathon visibility: run `arc-canteen login` then
# `arc-canteen rpc-url --export` and paste the proxied URL here. That
# routes our chain reads through the organisers' rate-limited proxy
# and lets them attribute traffic to our team.
# Both ARC_RPC (read by Python on_chain.py + web3.py log decode) and
# RPC (read by TS scripts as process.env.RPC) must point at the SAME
# endpoint to keep tx-hash / receipt views consistent.
ARC_RPC=https://rpc.testnet.arc.network
RPC=https://rpc.testnet.arc.network

# Upstream relayer (read-only consumption)
UPSTREAM_RELAYER_PATH=/Users/pauldudko/VSProjects/py-builder-relayer-client

# EIA API v2 — register at https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# IBKR Paper Gateway / TWS
IBKR_HOST=127.0.0.1
IBKR_GATEWAY_PORT=4002
IBKR_CLIENT_ID=42

# Runtime tuning
ARB_Z_THRESHOLD=1.0
ARB_K_FACTOR=0.5
ARB_KWH_PER_GPU_HR=0.7
